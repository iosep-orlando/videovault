# Copiá este fichero a .env.local y rellená los valores.
# No subas nunca .env.local al repositorio.

# MongoDB (metadatos y usuarios)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videovault

# RustFS (los vídeos). La API S3 va en un puerto y la consola web en otro.
# Si ya tenés otro RustFS o MinIO en el 9000, cambiá los dos puertos y el
# endpoint (por ejemplo 9020, 9021 y http://localhost:9020).
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ENDPOINT=http://localhost:9000
# Inventá unas credenciales propias: docker-compose.yml las usa para crear
# RustFS, y la app para conectarse. No uses "rustfsadmin".
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=videos

# URL de la app: RustFS solo acepta subidas desde este origen (CORS).
APP_URL=http://localhost:3000

# Secreto con el que se firman las sesiones: openssl rand -base64 32
JWT_SECRET=
